// Cloudflare Workers config. The site is fully static, so this only uploads
// the built files in dist/. There is no server code and no adapter.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatthedrill",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown URLs.
    "not_found_handling": "404-page",
    // Matches trailingSlash: 'always' in astro.config.mjs (/hitting -> /hitting/).
    "html_handling": "auto-trailing-slash"
  }
}
