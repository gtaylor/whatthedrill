---
// Shows the thumbnail and only loads YouTube's player (from the no-cookie
// domain) once someone taps play. Keeps pages fast and tracker-free.
import { formatTimestamp, youtubeEmbedUrl, youtubeId, youtubeThumbnail } from '../lib/youtube';

interface Props {
  url: string;
  title: string;
  channel: string;
  start?: number;
}

const { url, title, channel, start } = Astro.props;
const id = youtubeId(url)!;
---

<figure class="video">
  <div class="frame" data-lite-youtube data-embed={youtubeEmbedUrl(id, start)} data-title={title}>
    <img src={youtubeThumbnail(id)} alt="" width="480" height="360" decoding="async" />
    <button type="button" class="play" aria-label={`Play video: ${title}`}>
      <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l12 7-12 7z" fill="#C62A3B"></path></svg>
    </button>
  </div>
  <figcaption>
    Video by {channel} on <a href={url} rel="noopener" target="_blank">YouTube</a>{start ? ` · jumps to the drill at ${formatTimestamp(start)}` : ''}
  </figcaption>
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('[data-lite-youtube]')) {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.embed!;
      iframe.title = frame.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .video {
    margin: 0;
  }
  .frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink);
  }
  .frame img,
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .play {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
  .play:hover {
    transform: scale(1.05);
  }
  figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  figcaption a {
    color: inherit;
    font-weight: 600;
  }
</style>
