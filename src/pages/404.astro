---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="page missing">
    <p class="eyebrow">404</p>
    <h1 class="display">That one's foul.</h1>
    <p class="lede">We couldn't find that page. It may have moved, or the link has a typo.</p>
    <p><a href="/" class="button button--primary">Back to the home page</a></p>
  </div>
</Base>

<style>
  .missing {
    display: grid;
    gap: 14px;
    padding-block: 72px;
  }
</style>
